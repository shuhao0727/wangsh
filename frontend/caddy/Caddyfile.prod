:80 {
	log {
		level INFO
	}

	# 启用 Gzip 压缩
	encode gzip

	# 安全响应头
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Content Security Policy - 生产级安全防护
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' ws: wss:; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self';"
		-Server
	}

	root * /usr/share/caddy

	# Mindmap 的第三方运行时只保留在本地开发环境，不进入生产镜像。
	# 生产端明确返回 404，避免缺失资源被 SPA fallback 错误替换为 HTML。
	@mindmap_runtime path /mindmap-demo /mindmap-demo/*
	handle @mindmap_runtime {
		header Cache-Control "no-store"
		header Pragma "no-cache"
		header Expires "0"
		respond "" 404
	}

	# 公开课独立 HTML 与资源必须命中真实文件，且入口 HTML 不使用长期缓存，
	# 避免更新时引用已替换的资源，或把缺失的模块回退到 WangSh SPA。
	#
	# 两个容易踩的点（实测 caddy 2.8.4）：
	#   1. 只写 `/games/ai-partner/*` 时，尾部带斜线的 `/games/ai-partner/`
	#      会落到 `try_files {path} =404` 的目录分支变成 404；必须同时匹配裸路径，
	#      并用 `{path}/index.html` 让目录回到它自己的 index。
	#   2. 这里绝不能出现 `/index.html`——那会把缺失的 JS/HTML 用主站 SPA
	#      刷成 200，浏览器随后把 HTML 当模块脚本解析。
	@ai_partner path /games/ai-partner /games/ai-partner/*
	handle @ai_partner {
		try_files {path} {path}/index.html =404
		header Cache-Control "no-cache"
		file_server
	}

	# 构建产物与运行时静态文件必须命中真实文件；缺失时返回 404，
	# 不能回退到 index.html，否则浏览器会把 HTML 当成模块脚本加载。
	@static_assets path /assets/* /static/* /pyodide/* /favicon.ico /favicon.svg /robots.txt /manifest.json
	handle @static_assets {
		try_files {path} =404
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# 纯静态 SPA 路由回退
	handle {
		try_files {path} {path}/index.html /index.html
		header Cache-Control "no-cache, no-store, must-revalidate"
		header Pragma "no-cache"
		header Expires "0"
		file_server
	}
}
