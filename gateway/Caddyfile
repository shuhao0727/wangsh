{
	# Keep connection and header budgets at the Caddy server boundary. These
	# are native Caddy options; no third-party rate-limit module is assumed.
	servers {
		timeouts {
			read_header 5s
			read_body 30s
			write 30s
			idle 2m
		}
		max_header_size 64KB
	}
}

:80 {
	# Enforce one hard request-body ceiling before any route handler or upstream.
	# Caddy core returns 413 and rejects the body before reverse_proxy receives it.
	request_body {
		max_size 16MB
	}

	log {
		level INFO
	}

	# 启用 Gzip 压缩，显著减少传输体积
	encode gzip

	# 安全响应头
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# 后端 API 反向代理
	# 匹配 /api/health 并重写为 /health
	@api_health path /api/health
	handle @api_health {
		rewrite * /health
		reverse_proxy backend:8000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 60s
				write_timeout 30s
				keepalive 30s
			}
		}
	}

	# 匹配所有 /api/* 请求
	@api path /api/*
	handle @api {
		reverse_proxy backend:8000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 60s
				write_timeout 30s
				keepalive 30s
			}
		}
	}

	# 前端静态资源反向代理
	# 所有其他请求转发给 frontend 服务
	handle {

		# 静态资源长期缓存策略
		@static path /assets/* /static/* /pyodide/*
		header @static Cache-Control "public, max-age=31536000"

		@spa not path /assets/* /static/* /pyodide/*
		header @spa Cache-Control "no-cache, no-store, must-revalidate"
		header @spa Pragma "no-cache"
		header @spa Expires "0"

		reverse_proxy frontend:80 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 60s
				write_timeout 30s
				keepalive 30s
			}
		}
	}
}
