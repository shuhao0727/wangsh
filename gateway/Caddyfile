{
	# Keep connection and header budgets at the Caddy server boundary. These
	# are native Caddy options; no third-party rate-limit module is assumed.
	#
	# write 必须显式设为 0。
	# server 级 write_timeout 是「整个连接」的绝对写截止时间，不是「两次写之间的
	# 空闲时间」；它在 Caddy v2 的默认值是 30s，省略时仍会生效，并且优先于
	# reverse_proxy transport 里的 write_timeout——route 级设置覆盖不了它。
	# 曾经显式写 30s，导致后端每 15 秒发一次 keepalive 的 SSE 长连接在第 3 个
	# keepalive 之前被硬切断，前端只能不断退避重连，浏览器报
	# ERR_INCOMPLETE_CHUNKED_ENCODING。实测：30s（显式写或省略取默认）时连接
	# 恰好在 30s 断开；显式置 0 后同一 SSE 稳定跑满 80s。长连接的空闲回收交给 idle。
	servers {
		timeouts {
			read_header 5s
			read_body 30s
			write 0
			idle 2m
		}
		max_header_size 64KB
	}
}

:80 {
	# Enforce one hard request-body ceiling before any route handler or upstream.
	# Caddy core returns 413 and rejects the body before reverse_proxy receives it.
	request_body {
		max_size 16MB
	}

	log {
		level INFO
	}

	# 启用 Gzip 压缩，显著减少传输体积
	encode gzip

	# 安全响应头
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Content Security Policy - 生产级安全防护
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' ws: wss:; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self';"
		-Server
	}

	# 后端 API 反向代理
	# 匹配 /api/health 并重写为 /health
	@api_health path /api/health
	handle @api_health {
		rewrite * /health
		reverse_proxy backend:8000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 60s
				write_timeout 30s
				keepalive 30s
			}
		}
	}

	# SSE 长连接单独处理：/api 默认 transport 写超时 30s，而 SSE 在后端 keepalive
	# （15s 一次）之外可能长时间没有业务数据，超过就会被反向代理侧关掉。
	# stream 路径把 read/write timeout 置 0，由后端 keepalive 维持；空闲回收交给
	# server 级 idle 2m。
	# 注意顺序：handle 按声明顺序匹配，@api_stream 必须排在 @api 之前。
	@api_stream path /api/v1/admin/stream /api/v1/ai-agents/stream /api/v1/ai-agents/analysis/*/stream /api/v1/ai-agents/group-discussion/stream /api/v1/classroom/admin/stream
	handle @api_stream {
		reverse_proxy backend:8000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 60s
				read_timeout 0
				write_timeout 0
				keepalive 30s
			}
		}
	}

	# AI 伙伴评分：单次推理实测 24–43s，远超 @api 的 30s 上限。
	# response_header_timeout 卡的是「等后端返回响应头」的阶段——评分端点在
	# 整个模型推理期间都不发响应头，30s 一到 Caddy 就断开，前端拿到 502/504。
	# 这里放宽到 120s（后端预算 80s + 余量），并放开 read/write 以防大响应体。
	# 注意顺序：必须排在 @api 之前。
	@api_ai_partner path /api/v1/ai-partner/evaluate
	handle @api_ai_partner {
		reverse_proxy backend:8000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 120s
				read_timeout 120s
				write_timeout 120s
				keepalive 30s
			}
		}
	}

	# 匹配所有 /api/* 请求
	@api path /api/*
	handle @api {
		reverse_proxy backend:8000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 60s
				write_timeout 30s
				keepalive 30s
			}
		}
	}

	# 前端静态资源反向代理
	# 所有其他请求转发给 frontend 服务
	handle {

		# 静态资源长期缓存策略
		@static path /assets/* /static/* /pyodide/*
		header @static Cache-Control "public, max-age=31536000"

		@spa not path /assets/* /static/* /pyodide/*
		header @spa Cache-Control "no-cache, no-store, must-revalidate"
		header @spa Pragma "no-cache"
		header @spa Expires "0"

		reverse_proxy frontend:80 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 60s
				write_timeout 30s
				keepalive 30s
			}
		}
	}
}
