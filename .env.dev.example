# 本地开发配置模板；复制为 .env.dev 后填写四个必需的独立凭据。
# 不用于生产，不覆盖已有文件。宿主开发 PostgreSQL 由 Compose 发布到 5433。
PROJECT_NAME=WangSh
APP_VERSION=2.2.8
API_V1_STR=/api/v1
IMAGE_TAG=2.2.8
REACT_APP_VERSION=2.2.8
DEPLOYMENT_ENV=development
DEBUG=True
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=True
FRONTEND_PORT=6608
WEB_PORT=6608
REACT_APP_ENV=development
REACT_APP_API_URL=/api/v1
DEV_PROXY_TARGET=http://localhost:8000
FRONTEND_HOT_RELOAD=True
CORS_ORIGINS=["http://localhost:6608"]
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=wangsh_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_STATEMENT_TIMEOUT=60000
DATABASE_DRIVER=asyncpg
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_MAX_CONNECTIONS=150
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=
SECRET_KEY=
# 例如使用 openssl rand -base64 32 | tr '+/' '-_' 生成，不提交生成值。
AGENT_API_KEY_ENCRYPTION_KEY=
AGENT_TRUSTED_INTERNAL_ENDPOINTS=
# Cookie 安全：开发 HTTP 环境必须为 false，否则浏览器不会发送会话 Cookie
COOKIE_SECURE=false
AI_AGENT_MAX_OUTPUT_TOKENS=8192
DIFY_CONCURRENCY_ENABLED=true
DIFY_MAX_CONCURRENCY=20
DIFY_CONCURRENCY_WAIT_SECONDS=2
DIFY_CONCURRENCY_LEASE_SECONDS=180
# 评分智能体 ID：留空表示开发环境未配置评分智能体（评分接口会返回 503）
AI_PARTNER_SCORING_AGENT_ID=
PYTHONLAB_SANDBOX_IMAGE=shuhao07/pythonlab-sandbox:2.2.8
PYTHONLAB_DEFAULT_MEMORY_MB=128
PYTHONLAB_READINESS_TIMEOUT_SECONDS=60
TYPST_COMPILE_USE_CELERY=true
TYPST_STORE_PDF_IN_DB=false
AUTO_CREATE_TABLES=false
SQLALCHEMY_ECHO=false
TIMEZONE=Asia/Shanghai
# UPLOAD_FOLDER / TYPST_PDF_STORAGE_DIR 留给启动器的 data/dev 默认值；
# 本机个人覆盖使用 .env.local，显式路径不会被静默重写。
